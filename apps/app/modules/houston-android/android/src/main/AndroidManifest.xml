<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Overlay mode: show where the helper points, on top of other apps. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Screen sharing: react-native-webrtc runs a mediaProjection foreground service. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <!-- Full control: taps, swipes and typing for the helper, only while the person allows it. -->
    <service
      android:name="app.houston.android.HoustonAccessibilityService"
      android:exported="true"
      android:label="@string/houston_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/houston_accessibility_service" />
    </service>
  </application>
</manifest>
